# Firewall / Router Gateway Startup
ip addr add 10.10.1.1/24 dev eth0
ip addr add 10.10.2.1/24 dev eth1
ip addr add 10.10.3.1/24 dev eth2
ip addr add 10.10.4.1/24 dev eth3
ip addr add 10.10.99.1/24 dev eth4

ip link set dev eth0 up
ip link set dev eth1 up
ip link set dev eth2 up
ip link set dev eth3 up
ip link set dev eth4 up

sysctl -w net.ipv4.ip_forward=1

# Apply IEC 62443 Conduits and Firewall Rules
iptables -F
iptables -P FORWARD DROP
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# Strict isolation: Drop IT directly to OT
iptables -A FORWARD -s 10.10.1.0/24 -d 10.10.4.0/24 -j DROP

# Allow Enterprise to IDMZ services (SSH jump 22, Web HMI 8085)
iptables -A FORWARD -s 10.10.1.0/24 -d 10.10.2.10 -p tcp --dport 22 -j ACCEPT
iptables -A FORWARD -s 10.10.1.0/24 -d 10.10.2.30 -p tcp --dport 8085 -j ACCEPT

# Allow IDMZ Historian / DPI Proxy to poll OT PLCs on Modbus 502
iptables -A FORWARD -s 10.10.2.20 -d 10.10.4.0/24 -p tcp --dport 502 -j ACCEPT
iptables -A FORWARD -s 10.10.2.40 -d 10.10.4.0/24 -p tcp --dport 502 -j ACCEPT

# Allow EWS to OT for programming & diagnostics
iptables -A FORWARD -s 10.10.3.50 -d 10.10.4.0/24 -p tcp --dport 502 -j ACCEPT
iptables -A FORWARD -s 10.10.3.50 -d 10.10.4.0/24 -p tcp --dport 8080 -j ACCEPT

# Allow Intra-OT communication
iptables -A FORWARD -s 10.10.4.0/24 -d 10.10.4.0/24 -j ACCEPT

# Attacker isolated from OT
iptables -A FORWARD -s 10.10.99.0/24 -d 10.10.4.0/24 -j DROP
iptables -A FORWARD -s 10.10.99.0/24 -d 10.10.1.0/24 -j ACCEPT
